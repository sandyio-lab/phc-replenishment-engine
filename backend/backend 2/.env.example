# Copy this file to .env and fill in your real keys.
# Never commit .env to git — add it to .gitignore.

# ── Google Gemini ────────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Twilio (for real SMS sending) ────────────────────────────────────────────
# Find these in your Twilio Console: https://console.twilio.com
# Leave blank to use dry_run mode only (no SMS will be sent).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio number to send FROM (must be purchased in your Twilio account).
# Format: E.164, e.g. +12015551234
# On a trial account, the TO number must also be a verified caller ID.
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ── Notes ────────────────────────────────────────────────────────────────────
# dispatch_low_stock_alert() defaults to dry_run=True — it will NOT spend
# a Twilio credit unless you explicitly pass dry_run=False.
# You can test message composition fully without any Twilio credentials.
